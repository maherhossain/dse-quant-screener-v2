@'
# DSE Quant Screener v2 — environment template
# Copy to .env and fill in per machine. .env is git-ignored.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dse_quant_v2

# --- Recorded environment (informational, for reproducibility logs) ---
ENV_MYSQL_VERSION=8.0.30
ENV_PYTHON_VERSION=3.12.0

# --- Project (documentation only; code derives paths from __file__) ---
PROJECT_ROOT_OFFICE=C:\laragon\www\dse-quant-screener-v2
PROJECT_ROOT_LAPTOP=D:\laragon\www\dse-quant-screener-v2
'@ | Set-Content -Encoding UTF8 .env.example